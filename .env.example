PORT=4000
# Bind the adapter to loopback behind the reverse proxy unless a deliberate deployment override is required.
HOST=127.0.0.1
NODE_ENV=development
MONGO_URI=<mongodb-connection-string>
INTERNAL_API_KEY=<long-random-server-to-server-secret>

# Inchill upstream configuration.
INCHILL_WEB_BASE_URL=https://www.inchillapp.com
INCHILL_API_BASE_URL=https://api.inchillapp.com
INCHILL_UAAS_BASE_URL=https://i.inchillapp.com
INCHILL_TURNOVER_BASE_URL=https://db-turnover.inchillapp.com

# Base64-encoded 32-byte AES-256-GCM key; generate and store in a secret manager.
INCHILL_SESSION_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
INCHILL_REQUEST_TIMEOUT_MS=15000
# Optional stable, backend-managed device identifier for SMS authentication.
# When this is set, clients do not need to submit deviceId to /verify-otp.
INCHILL_DEVICE_ID=<trusted-fingerprintjs-compatible-device-id>
# Required for turnover headers unless stored per account during OTP verification.
INCHILL_COUNTRY=<two-letter-country-code>
INCHILL_LANGUAGE=en

# Diamond controls remain guarded and disabled by default.
INCHILL_MUTATIONS_ENABLED=false
INCHILL_CONTROLLED_MUTATION_MODE=false
# Required only when INCHILL_CONTROLLED_MUTATION_MODE=true; set outside source control.
INCHILL_CONTROLLED_MUTATION_MAX_AMOUNT=<authorized-controlled-test-ceiling>

# Optional: when unset, Swagger is enabled outside production and disabled in
# production. Set true to explicitly expose /docs and /openapi.json.
SWAGGER_ENABLED=false
