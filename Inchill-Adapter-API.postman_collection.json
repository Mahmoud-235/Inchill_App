    "event":  [
                  {
                      "listen":  "prerequest",
                      "script":  {
                                     "type":  "text/javascript",
                                     "exec":  [
                                                  "if (!pm.environment.get(\u0027INTERNAL_API_KEY\u0027)) {",
                                                  "  console.warn(\u0027INTERNAL_API_KEY is not set. Add it to the environment before calling protected routes.\u0027);",
                                                  "}",
                                                  "pm.request.headers.upsert({ key: \u0027x-internal-api-key\u0027, value: pm.environment.get(\u0027INTERNAL_API_KEY\u0027) || \u0027{{INTERNAL_API_KEY}}\u0027 });",
                                                  "pm.request.headers.upsert({ key: \u0027Content-Type\u0027, value: \u0027application/json\u0027 });"
                                              ]
                                 }
                  }
