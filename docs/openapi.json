{
  "openapi": "3.0.3",
  "info": {
    "title": "Inchill Adapter API",
    "version": "1.0.0",
    "description": "V1-only Inchill backend contract. No tenant or multi-client flow is exposed."
  },
  "servers": [{ "url": "/" }],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-api-key"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "security": [],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness check",
        "security": [],
        "responses": { "200": { "description": "READY" }, "503": { "description": "NOT_READY" } }
      }
    },
    "/api/auth/send-otp": {
      "post": {
        "summary": "Request an OTP",
        "security": [{ "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "Accepted" }, "400": { "description": "Invalid request" } }
      }
    },
    "/api/auth/verify-otp": {
      "post": {
        "summary": "Verify OTP and establish the session",
        "security": [{ "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "Success" }, "400": { "description": "Invalid request" } }
      }
    },
    "/api/bot/session/validate": {
      "post": {
        "summary": "Validate stored session",
        "security": [{ "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "Session result" } }
      }
    },
    "/api/bot/verify-id": {
      "post": {
        "summary": "Resolve a target identity",
        "security": [{ "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/api/bot/wallet-balance": {
      "post": {
        "summary": "Fetch wallet balance",
        "security": [{ "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "Wallet balance" } }
      }
    },
    "/api/bot/account-history": {
      "post": {
        "summary": "Fetch account history",
        "security": [{ "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "History" } }
      }
    },
    "/api/bot/agent-profile": {
      "post": {
        "summary": "Fetch agent profile",
        "security": [{ "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "Profile" } }
      }
    },
    "/api/bot/transfer-readiness": {
      "post": {
        "summary": "Read-only transfer readiness",
        "security": [{ "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "Readiness" } }
      }
    },
    "/api/bot/transactions": {
      "post": {
        "summary": "List an agent's Diamond recharge transactions",
        "security": [{ "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "Transactions" }, "400": { "description": "Invalid request" } }
      }
    },
    "/api/bot/recharge/preview": {
      "post": {
        "summary": "Preview a Diamond recharge",
        "security": [{ "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "Preview" }, "400": { "description": "Invalid request" } }
      }
    },
    "/api/bot/recharge/diamond": {
      "post": {
        "summary": "Recharge Diamonds",
        "security": [{ "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "Recharge completed" }, "400": { "description": "Invalid request" }, "409": { "description": "Rejected" }, "503": { "description": "Disabled or blocked" } }
      }
    },
    "/api/bot/recharge/reconcile": {
      "post": {
        "summary": "Reconcile an unknown Diamond recharge",
        "security": [{ "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "Reconciliation data" }, "400": { "description": "Invalid request" }, "404": { "description": "Transaction not found" }, "409": { "description": "Not applicable" } }
      }
    }
  }
}
